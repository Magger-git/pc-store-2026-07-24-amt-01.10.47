# Порт, на котором запускается сервер
PORT=3000

# Строка подключения к PostgreSQL.
# Локально: если ставили Postgres.app / стандартный PostgreSQL, обычно
#   postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5432/pc_store
# На Render: скопируйте "External Database URL" из вашей Postgres-базы
#   в разделе Dashboard -> ваша БД -> Connect.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pc_store

# Ключ Stripe для реальной оплаты (тестовый или боевой).
# Если оставить пустым — заказы будут оформляться в mock-режиме
# (без реальной оплаты, сразу со статусом "оплачено") — удобно для разработки.
# Получить тестовый ключ: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Пароль для входа в панель администратора (/admin.html).
# Если оставить пустым, используется пароль по умолчанию "admin" —
# обязательно задайте свой пароль перед тем, как выкладывать сайт в интернет.
ADMIN_PASSWORD=change-me-please
